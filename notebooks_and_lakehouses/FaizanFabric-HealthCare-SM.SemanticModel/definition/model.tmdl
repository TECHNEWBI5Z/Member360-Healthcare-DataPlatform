model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake - HealthcareLakehouse"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit"]

ref table fact_condition
ref table dim_organization
ref table fact_medication
ref table dim_provider
ref table fact_observation
ref table dim_patient
ref table fact_allergy
ref table dim_date
ref table fact_encounter

